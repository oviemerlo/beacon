{
  "expo": {
    "name": "EchoToCrowd",
    "slug": "echotocrowd-mobile",
    "version": "0.1.5",
    "icon": "./assets/echotocrowd-icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "echotocrowd",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.echotocrowd.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EchoToCrowd uses your location to show broadcasts posted near you and to set the radius your own broadcasts reach.",
        "NSPhotoLibraryUsageDescription": "EchoToCrowd lets you attach photos to echoes and messages.",
        "NSCameraUsageDescription": "EchoToCrowd lets you take photos to share in echoes and messages.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.echotocrowd.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/echotocrowd-icon-1024.png",
        "backgroundColor": "#D85A30"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0D0E14"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#12131C"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.997147869048-6va16ikp7bkrseosorf2rcs9stcqdn7b"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "aaf3057e-d4d9-4219-8909-dfcb5d20f166"
      }
    }
  }
}
