DATABASE_URL=
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MOBILE_CLIENT_IDS=

# Bundle ID. client_id for Apple's token and revoke endpoints.
APPLE_CLIENT_ID=com.echotocrowd.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# PEM of the .p8 key, with literal \n escapes. Preferred on Railway.
APPLE_PRIVATE_KEY=
# Fernet key for encrypting stored Apple refresh tokens.
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_REDIRECT_URI=
# Identity-token audiences. JSON list or comma-separated.
# Native iOS aud is the bundle ID; add a web Services ID here if you use one.
APPLE_CLIENT_IDS=com.echotocrowd.app

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

INTERNAL_JOB_TOKEN=
INTERNAL_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_EMAIL=

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
